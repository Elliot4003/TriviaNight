@{
    ViewData["Title"] = "Trivia Night";
}

@model CategoriesList

<style>
    .accordion-button[aria-expanded="true"] {
        background-color: #23272b;
        color: white;
    }

    .accordion-button::after {
        display: none !important;
    }

</style>

<div class="d-flex justify-content-center mt-4">
    <h1>Categories</h1>
</div>
<div class="d-flex justify-content-center align-items-center text-center mt-4">
    <div class="accordion accordion-flush" id="accordion">
        <div class="container">
            <div class="row">
                @{
                    string collapse;
                    string heading;
                    int i = 0;
                    foreach (CategoryModel category in Model.Categories)
                    {
                        if (category.QuestionCount >= 10)
                        {
                            i++;
                            collapse = "collapse" + i.ToString();
                            heading = "heading" + i.ToString();

                            <div class="col-md-6">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="@heading">
                                        <button class="accordion-button collapsed btn-outline-dark shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#@collapse" aria-expanded="false" aria-controls="@collapse">
                                            @category.Name
                                        </button>
                                    </h2>
                                    <div id="@collapse" class="accordion-collapse collapse" aria-labelledby="@heading" data-bs-parent="#accordion">
                                        <div class="accordion-body">
                                            <form asp-action="Questions" asp-controller="Questions" method="post">
                                                <div class="container">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group">
                                                                <input class="visually-hidden" value="@category.Id" name="category" />
                                                                <label for="amount" class="start-0">Amount of questions</label>
                                                                <select class="form-control shadow-none mt-2" name="amount" id="amount">
                                                                    <option>10</option>
                                                                    @{
                                                                        if (@category.QuestionCount >= 20)
                                                                        {
                                                                            <option>20</option>
                                                                        }
                                                                        if (@category.QuestionCount >= 30)
                                                                        {
                                                                            <option>30</option>
                                                                        }
                                                                        if (@category.QuestionCount >= 40)
                                                                        {
                                                                            <option>40</option>
                                                                        }
                                                                        if (@category.QuestionCount >= 50)
                                                                        {
                                                                            <option>50</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group">
                                                                <label for="difficulty">Difficulty</label>
                                                                <select class="form-control shadow-none mt-2" name="difficulty" id="difficulty">
                                                                    <option>Easy</option>
                                                                    <option>Medium</option>
                                                                    <option>Hard</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <button type="submit" class="btn btn-outline-dark shadow-none mt-3">Go !</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

