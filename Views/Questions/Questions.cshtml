@using System.Net

@{
    ViewData["Title"] = "Questions";
}

@model QuestionModel

@{
    string question;
    List<string> answers = new List<string>();

    question = WebUtility.HtmlDecode(Model.Question);
    answers = Model.IncorrectAnswers;

    // Randomisation de l'ordre
    Random rand = new Random();
    if (Model.Type == "multiple") answers.Insert(rand.Next(4), Model.CorrectAnswer);
    else answers.Insert(rand.Next(2), Model.CorrectAnswer);
}

<style>
    html, body {
        margin: 0;
        height: 100%;
        overflow: hidden
    }
</style>
<div>
    <div class="container">
        <div class="row">
            <div class="d-flex justify-content-center text-center align-items-center" style="height:50vh">
                <h2>@question</h2>
            </div>
        </div>
        <div class="row">
            <div class="container justify-content-center text-center align-items-center">
                @{
                if(Model.Type == "multiple") {
                    <div class="row g-5">
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@answers[0]">@WebUtility.HtmlDecode(answers[0])</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@answers[1]">@WebUtility.HtmlDecode(answers[1])</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@answers[2]">@WebUtility.HtmlDecode(answers[2])</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@answers[3]">@WebUtility.HtmlDecode(answers[3])</button>
                        </div>
                    </div>
                } else {
                    <div class="row g-5">
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@answers[0]">@answers[0]</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@answers[1]">@answers[1]</button>
                        </div>
                    </div>
                }
            }
            </div>
        </div>
    </div>
</div>
    
