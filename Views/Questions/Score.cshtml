
@{
    ViewData["Title"] = "Score";
}

@model ScoreModel

<style>

    .loader {
        border: 14px solid #f3f3f3;
        border-top: 14px solid #23272b;
        border-radius: 50%;
        width: 80px;
        height: 80px;
        animation: spin 2s linear infinite;
    }

    @@keyframes spin {
        0%{
        transform: rotate(0deg);}
        100% {
            transform: rotate(360deg);}
    }
</style>
<div class="container">
    <div class="d-flex justify-content-center align-items-center" style="height:20vh">
        <h1>Score</h1>
    </div>
    <div class="row justify-content-center">
        <div class="col-auto d-flex flex-column align-items-center px-5">
            <div class="mb-0 pb-0" style="font-size:80px">
                @Model.Score
            </div>
            <hr style="height:5px;width:100%;" />
            <div class="mb-0 pb-0" style="font-size:80px">
                @Model.QuestionCount
            </div>
        </div>
        <div id="loaderDiv" class="col-auto d-flex flex-column justify-content-center">
            <div id="loader" class="loader"></div>
        </div>
        <img id="gif" src="~/images/blank.png" alt="gif" class="col-auto d-flex flex-column align-items-center" />
    </div>
    <div class="d-flex justify-content-center align-items-center" style="height:25vh">
        <button class="btn btn-outline-dark btn-lg shadow-none" onclick="window.location.href='Categories';">Back to categories</button>
    </div>
    <input id="scoreResult" value="@Model.ScoreResult" class="d-none" />
</div>
@section Scripts {
    <script type="text/javascript">

        const badResultWordsList = [
            "disappointment",
            "failure",
            "sad"
        ];

        const mediumResultWordsList = [
            "you got this",
            "you can do it",
            "keep it up"
        ];

        const goodResultWordsList = [
            "bravo",
            "well done",
            "good job"
        ];

        const perfectResultWordsList = [
            "amazing",
            "congrats",
            "champion"
        ];

        let searchTerm = "";
        const scoreResult = document.getElementById("scoreResult").value;

        switch(scoreResult) {
            case "Bad":
                searchTerm = badResultWordsList[Math.floor(Math.random() * badResultWordsList.length)];
                break;
            case "Medium":
                searchTerm = mediumResultWordsList[Math.floor(Math.random() * mediumResultWordsList.length)];
                break;
            case "Good":
                searchTerm = goodResultWordsList[Math.floor(Math.random() * goodResultWordsList.length)];
                break;
            case "Perfect":
                searchTerm = perfectResultWordsList[Math.floor(Math.random() * perfectResultWordsList.length)];
                break;
            default:
                break;
        }

        const apiKey = '8YXNVSEDUgBDuvgGhdM02qzPUFVOYyjs';
        const apiUrl = `https://api.giphy.com/v1/gifs/search?api_key=${apiKey}&q=${searchTerm}&limit=30`;
        const img = document.getElementById("gif");
        const loader = document.getElementById("loader");
        const loaderDiv = document.getElementById("loaderDiv");
        const localStorageKey = 'savedGif';
        const savedGif = JSON.parse(localStorage.getItem(localStorageKey));

        if (savedGif) img.src = savedGif;
        else {
            fetch(apiUrl)
            .then(response => response.json())
            .then(data => {
                console.log(data);
                if(data.data.length > 0) {
                    const index = Math.floor(Math.random() * data.data.length);
                    const gifUrl = data.data[index].images.fixed_height.url;
                    localStorage.setItem(localStorageKey, JSON.stringify(gifUrl)); // Enregistrer le gif dans le localstorage pour éviter des appels inutiles à l'API

                    img.src = gifUrl;
                } else {
                    console.log("No GIF found.")
                }
            })
            .catch(error => {
                console.error("API error : ", error)
            });
        }

        img.addEventListener("load", () => {
            loader.style.display = "none";
            loaderDiv.style.display = "none";
        });
        
    </script>
}