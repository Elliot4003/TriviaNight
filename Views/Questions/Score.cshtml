@*
   Si le score est mauvais, recherche de GIF avec des mots clés comme "disappointed", "sad", etc
   Si le score est moyen, recherche de GIF avec des mots clé comme "encourage", "keep it up", etc
   Si le score est bon, recherche de GIF avec des mots clé comme "bravo", "champion", etc
   Si le score est parfait, recherche de GIF avec des mots clé comme "amazing", "incredible", etc
*@

@{
    ViewData["Title"] = "Score";
}

@model ScoreModel

<style>
    html, body {
        margin: 0;
        height: 100%;
        overflow: hidden
    }
</style>
<div class="container">
    <div class="row d-flex justify-content-center align-items-center text-center" style="height:20vh">
        <div>
            <h1>Score</h1>
        </div>
    </div>
    <div class="row d-flex justify-content-center align-items-center text-center">
        <div class="col col-lg-auto">
            <div class="mb-0 pb-0" style="font-size:4.5vw">
                @Model.Score
            </div>
            <hr style="height:5px;" />
            <div class="mb-0 pb-0" style="font-size:4.5vw">
                @Model.QuestionCount
            </div>
        </div>
        <div class="col col-lg-auto p-5">
            <img id="gif" />
        </div>
    </div>
    <div class="row d-flex justify-content-center align-items-center text-center pt-5">
        <div>
            <button class="btn btn-outline-dark btn-lg shadow-none" onclick="window.location.href='Categories';">Back to categories</button>
        </div>
    </div>
    <input id="scoreResult" value="@Model.ScoreResult" class="d-none" />
</div>
@section Scripts {
    <script type="text/javascript">

        const badResultWordsList = [
            "disappointment",
            "failure",
            "bummer",
            "downer"
        ];

        const mediumResultWordsList = [
            "encourage",
            "motivate",
            "keep it up"
        ];

        const goodResultWordsList = [
            "bravo",
            "champion",
            "well done",
            "Good job"
        ];

        const perfectResultWordsList = [
            "genius",
            "amazing",
            "incredible",
            "mastermind"
        ];

        let searchTerm = "";
        const scoreResult = document.getElementById("scoreResult").value;

        switch(scoreResult) {
            case "Bad":
                searchTerm = badResultWordsList[Math.floor(Math.random() * badResultWordsList.length)];
                break;
            case "Medium":
                searchTerm = mediumResultWordsList[Math.floor(Math.random() * mediumResultWordsList.length)];
                break;
            case "Good":
                searchTerm = goodResultWordsList[Math.floor(Math.random() * goodResultWordsList.length)];
                break;
            case "Perfect":
                searchTerm = perfectResultWordsList[Math.floor(Math.random() * perfectResultWordsList.length)];
                break;
            default:
                break;
        }

        const apiKey = '8YXNVSEDUgBDuvgGhdM02qzPUFVOYyjs';
        const apiUrl = `https://api.giphy.com/v1/gifs/search?api_key=${apiKey}&q=${searchTerm}&limit=30`;
        const img = document.getElementById("gif");
        const localStorageKey = 'savedGif';
        const savedGif = JSON.parse(localStorage.getItem(localStorageKey));

        if (savedGif) img.src = savedGif;
        else {
            fetch(apiUrl)
            .then(response => response.json())
            .then(data => {
                console.log(data);
                if(data.data.length > 0) {
                    const index = Math.floor(Math.random() * data.data.length);
                    const gifUrl = data.data[index].images.fixed_height.url;
                    localStorage.setItem(localStorageKey, JSON.stringify(gifUrl)); // Enregistrer le gif dans le localstorage pour éviter des appels inutiles à l'API

                    img.src = gifUrl;
                } else {
                    console.log("No GIF found.")
                }
            })
            .catch(error => {
                console.error("API error : ", error)
            });
        }

    </script>
}