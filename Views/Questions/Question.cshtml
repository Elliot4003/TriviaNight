@using System.Net

@{
    ViewData["Title"] = "Questions";
}

@model QuestionModel

@{
    List<string> answers = Model.IncorrectAnswers ?? [];
    string difficulty = "";

    // Randomisation de l'ordre
    Random rand = new Random();
    if (Model.CorrectAnswer != null)
    {
        if (Model.Type == "multiple") answers.Insert(rand.Next(4), Model.CorrectAnswer);
        else {
            if(Model.CorrectAnswer == "True")
            {
                answers.Insert(0, Model.CorrectAnswer);
            } else {
                answers.Insert(1, Model.CorrectAnswer);
            }
        }
    }
    if (Model.Difficulty != null) difficulty = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(Model.Difficulty.ToLower());
}

<style>
    html, body {
        margin: 0;
        height: 100%;
        overflow: hidden
    }
</style>
<div class="position-absolute start-0 p-2">
    <div class="container">
        <div class="row">
            <p>
                <strong>@WebUtility.HtmlDecode(Model.Category)</strong> - @difficulty
            </p>
        </div>
        <div class="row">
            <p><strong>Score :</strong> @ViewBag.Score/@ViewBag.QuestionCount</p>
        </div>
    </div>
</div>
<div class="position-absolute end-0 p-2">
    <div class="container">
        <div class="row">
            <p>Question n°@ViewBag.Id</p>
        </div>
    </div>
</div>
<div class="container">
    <div class="row">
        <div class="d-flex justify-content-center text-center align-items-center" style="height:45vh">
            <h2>@WebUtility.HtmlDecode(Model.Question)</h2>
        </div>
    </div>
    <div class="row">
        <div class="container justify-content-center text-center align-items-center">
            @{
                if(Model.Type == "multiple") {
                    <div class="row g-5">
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@WebUtility.HtmlDecode(answers[0])" onclick="checkAnswer(this)">@WebUtility.HtmlDecode(answers[0])</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@WebUtility.HtmlDecode(answers[1])" onclick="checkAnswer(this)">@WebUtility.HtmlDecode(answers[1])</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@WebUtility.HtmlDecode(answers[2])" onclick="checkAnswer(this)">@WebUtility.HtmlDecode(answers[2])</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@WebUtility.HtmlDecode(answers[3])" onclick="checkAnswer(this)">@WebUtility.HtmlDecode(answers[3])</button>
                        </div>
                    </div>
                } else {
                    <div class="row g-5">
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@WebUtility.HtmlDecode(answers[0])" onclick="checkAnswer(this)">@answers[0]</button>
                        </div>
                        <div class="col">
                            <button class="btn btn-outline-dark btn-lg shadow-none" value="@WebUtility.HtmlDecode(answers[1])" onclick="checkAnswer(this)">@answers[1]</button>
                        </div>
                    </div>
                }
                <input id="correctAnswer" value="@WebUtility.HtmlDecode(Model.CorrectAnswer)" class="d-none" />
                <input id="questionId" value="@ViewBag.Id" class="d-none" />
            }
        </div>
    </div>
</div>
@section Scripts {
    <script type="text/javascript">

        function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        function saveAnswerAndScore(result) {

            const questionId = document.getElementById("questionId").value;

            console.log("test");

            return fetch('/Questions/SaveAnswerAndScore', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body : JSON.stringify(result ? questionId + "_correct" : questionId + "_incorrect")
                })
                .catch(error => console.error("Erreur Fetch:", error));
        }

        async function checkAnswer(button) {

            const correctAnswer = document.getElementById("correctAnswer").value;
            const questionId = document.getElementById("questionId").value;

            document.querySelectorAll(".btn").forEach(btn => {
                btn.disabled = true;
                btn.style.opacity = "1";
            });
            
            // Vérification de la réponse puis redirection
            if (button.value == correctAnswer) {
                button.className = "btn btn-success btn-lg shadow-none";
                await sleep(2000);
                await saveAnswerAndScore(true);
                window.location.href = "Question";
            } else {
                document.querySelector('button[value="' + correctAnswer + '"]').className = "btn btn-success btn-lg shadow-none";
                button.className = "btn btn-danger btn-lg shadow-none";
                await sleep(3000);
                await saveAnswerAndScore(false);
                window.location.href = "Question";
            }
        }

    </script>
}

