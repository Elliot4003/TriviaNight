@{
    ViewData["Title"] = "Trivia Night";
}

@model List<CategoryModel>


<div class="accordion accordion-flush" id="accordion">
    @{
        string collapse;
        string heading;
        int i = 0;
        foreach(CategoryModel category in Model)
        {
            if(category.QuestionCount >= 10)
            {
                i++;
                collapse = "collapse" + i.ToString();
                heading = "heading" + i.ToString();

                <div class="accordion-item">
                    <h2 class="accordion-header" id="@heading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapse" aria-expanded="false" aria-controls="@collapse">
                            @category.Name
                        </button>
                    </h2>
                    <div id="@collapse" class="accordion-collapse collapse" aria-labelledby="@heading" data-bs-parent="#accordion">
                        <div class="accordion-body">
                            <form asp-action="Questions" asp-controller="Category">
                                <div class="form-group">
                                    <input style="display:none" value="@category.Id" name="Category" />
                                    <label for="amount" class="start-0">Amount of questions</label>
                                    <select class="form-control mt-2" id="amount" name="Amount">
                                        <option>10</option>
                                        @{
                                            if (@category.QuestionCount >= 20)
                                            {
                                                <option>20</option>
                                            } 
                                            if (@category.QuestionCount >= 30)
                                            {
                                                <option>30</option>
                                            }
                                            if (@category.QuestionCount >= 40)
                                            {
                                                <option>40</option>
                                            }
                                            if (@category.QuestionCount >= 50)
                                            {
                                                <option>50</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="form-group mt-2">
                                    <label for="difficulty">Difficulty</label>
                                    <select class="form-control mt-2" id="difficulty">
                                        <option>Easy</option>
                                        <option>Medium</option>
                                        <option>Hard</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-primary mt-3">Go !</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>
