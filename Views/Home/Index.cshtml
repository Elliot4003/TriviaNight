@{
    ViewData["Title"] = "Trivia Night";
}

@model List<CategoryModel>

<div class="text-center">
    @{
        foreach(CategoryModel category in Model)
        {
            <div class="accordion mt-4" id="accordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                            @category.Name
                        </button>
                    </h2>
                    <div id="collapseForm" class="accordion-collapse collapse" data-bs-parent="#accordion">
                        <div class="accordion-body">
                            <form asp-action="Trivia">
                                <div class="form-group">
                                    <label for="amount">Amount of questions</label>
                                    <select class="form-control" id="amount">
                                        @category.QuestionCount > 10 ? <option>10</option> : <option>20</option>
                                        <option>20</option>
                                        <option>30</option>
                                        <option>40</option>
                                        <option>50</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="exampleFormControlSelect1">Example select</label>
                                    <select class="form-control" id="difficulty">
                                        <option>Easy</option>
                                        <option>Medium</option>
                                        <option>Hard</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-primary">Go !</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container mt-5">
                <div class="card">
                    <!--<img src="https://via.placeholder.com/300" class="card-img-top" alt="Image">-->
                    <div class="card-body">
                        <h5 class="card-title">@category.Name</h5>
                        <a asp-action="Category" asp-controller="Home" asp-route-id="@category.Id"></a>
                    </div>
                </div>
            </div>
        }
    }
</div>
